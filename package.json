{
  "name": "vellozap-food-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --import @swc-node/register/esm-register --watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --import ./test/helpers/setup.mjs --import @swc-node/register/esm-register --test-concurrency=1 --test \"test/**/*.test.ts\"",
    "test:unit": "node --import ./test/helpers/setup.mjs --import @swc-node/register/esm-register --test \"test/unit/**/*.test.ts\"",
    "test:integration": "node --import ./test/helpers/setup.mjs --import @swc-node/register/esm-register --test-concurrency=1 --test \"test/integration/**/*.test.ts\"",
    "test:contract": "node --import ./test/helpers/setup.mjs --import @swc-node/register/esm-register --test \"test/contract/**/*.test.ts\"",
    "test:watch": "node --import ./test/helpers/setup.mjs --import @swc-node/register/esm-register --test --watch \"test/**/*.test.ts\"",
    "test:coverage": "node --import ./test/helpers/setup.mjs --import @swc-node/register/esm-register --test --experimental-test-coverage \"test/**/*.test.ts\"",
    "migration:run": "node --import @swc-node/register/esm-register scripts/migrate.ts run",
    "migration:revert": "node --import @swc-node/register/esm-register scripts/migrate.ts revert",
    "db:baseline": "node --import @swc-node/register/esm-register scripts/baseline.ts"
  },
  "dependencies": {
    "argon2": "^0.41.1",
    "axios": "^1.7.9",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "date-fns": "^3.6.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "routing-controllers": "^0.10.4",
    "tsyringe": "^4.8.0",
    "typeorm": "^0.3.20",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@swc-node/register": "^1.11.1",
    "@swc/core": "^1.15.40",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.5",
    "eslint": "^9.17.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
