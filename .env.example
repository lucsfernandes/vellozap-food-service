# App
NODE_ENV=development
PORT=3333
API_PREFIX=/api
CORS_ORIGIN=http://localhost:8080
# Number of reverse-proxy hops in front of the app (Express `trust proxy`).
# 0 = no proxy. Set to the hop count in production so rate limiting keys on the real client IP.
TRUST_PROXY=0

# Rate limiting (auth routes)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_REFRESH_MAX=30

# Database (Postgres). In production points to the Supabase pooler with a service role.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/vellozap
DATABASE_SSL=false
DATABASE_CA_CERT=
DB_LOGGING=false

# Auth / JWT
JWT_ACCESS_SECRET=change-me-to-a-long-random-secret-32chars-min
JWT_ISSUER=vellozap-food
JWT_AUDIENCE=vellozap-food-frontend
ACCESS_TTL=15m
REFRESH_TTL=30d

# Argon2
ARGON_MEMORY_COST=19456
ARGON_TIME_COST=2
ARGON_PARALLELISM=1

# WhatsApp
WHATSAPP_PROVIDER=evolution
EVOLUTION_API_URL=https://evo.example.com
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=vellozap
EVOLUTION_WEBHOOK_SECRET=
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=

# Storage (logo/images)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./uploads
STORAGE_PUBLIC_BASE_URL=http://localhost:3333/uploads

# External
VIACEP_BASE_URL=https://viacep.com.br/ws

# Social (future)
# GOOGLE_CLIENT_ID=
